{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agent-coordinator": {
      "type": "stdio",
      "command": "python3",
      "args": [
        "${PLUGIN_ROOT}/scripts/mcp_launcher.py",
        "coordinator"
